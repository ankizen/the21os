# Copy to .env and fill in real values. Never commit the real .env.
# Used by docker-compose.yml when deploying as a single Coolify Service.

# ---- Phase 1 (required now) ----------------------------------------------

ENV=prod
POSTGRES_USER=the21secrets
POSTGRES_PASSWORD=
POSTGRES_DB=the21secrets

# Signs the dashboard's session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Seeds the single admin user on first boot only. Change the password via the
# app itself after that — this value is ignored once a user row exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=https://ads.the21secrets.com

# The frontend's public API base URL. Baked in at DOCKER BUILD time (Next.js
# inlines NEXT_PUBLIC_* into the client bundle) — changing this requires a
# rebuild, not just a container restart.
NEXT_PUBLIC_API_URL=https://api.the21secrets.com

# ---- Phase 2 (required now) — Meta Ads. See META_SETUP.md. ----------------

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_DEFAULT_AD_ACCOUNT_ID=
META_API_VERSION=v26.0

# ---- Phase 5+ (Google Analytics — not read by the app yet) ----------------

GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/ga4-service-account.json
GOOGLE_PROJECT_ID=
GA4_PROPERTY_ID=

# ---- Phase 6+ (Claude / MCP — not read by the app yet) --------------------

ANTHROPIC_API_KEY=
MCP_AUTH_TOKEN=
